# Copy to .env. Everything here is optional in development.
PORT=4000
# Public URL used in password-reset and invoice emails.
APP_URL=https://billing.example.com
# Local SQLite database file. Created and migrated automatically on boot.
DATABASE_PATH=./data/brightloop.db
# SMTP connection. When unset, emails are recorded in Settings > Email log and not delivered.
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Brightloop Billing <billing@example.com>
# Creates the first admin on an empty production database.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Only for trying a production build over plain http on a machine that is not localhost.
# ALLOW_INSECURE_COOKIES=1
# Number of reverse proxies in front of the app (needed for secure cookies and rate limiting).
TRUST_PROXY=1
